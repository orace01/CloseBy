# Copy to .env.local and fill in.

# Database. Locally: the docker compose container.
# On Vercel with Supabase: the "transaction pooler" URL (port 6543).
DATABASE_URL=postgres://closeby:closeby@localhost:5432/closeby

# Only for `npm run db:migrate` against a hosted database:
# the Supabase "session pooler" URL (port 5432).
# DATABASE_URL_MIGRATIONS=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Public URL of the app. On Vercel, the production URL (https://...).
BETTER_AUTH_URL=http://localhost:3000

# Email confirmation and password reset need an email provider.
# Set to false until a domain and provider are configured.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Comma-separated addresses allowed to open /admin
ADMIN_EMAILS=

# Agent (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Models tried in order; the next one is used when a model's daily free quota runs out.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Search Google for emails of businesses without a site (requires Gemini billing).
AGENT_WEB_SEARCH=false
# Limits that keep usage within the free quota.
AGENT_MAX_PROSPECTS=10
AGENT_MAX_CAMPAIGNS_PER_DAY=3

# Business search with Google Maps (Places API (New)). Optional: without it the
# agent searches OpenStreetMap, which only lists businesses that have a website.
GOOGLE_MAPS_API_KEY=
